{
  "name": "claude-oauth-bridge",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "Local HTTP bridge exposing Claude Code OAuth-backed model endpoints.",
  "scripts": {
    "dev": "tsx src/index.ts",
