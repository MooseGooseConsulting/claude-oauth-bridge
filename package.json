  "engines": {
    "node": ">=22"
  },
  "dependencies": {},
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "25.9.5",
    "eslint": "9.39.5",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "typescript-eslint": "8.69.0",
    "vitest": "4.1.11"
  }
}
